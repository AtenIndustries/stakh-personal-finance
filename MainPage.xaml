<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Stakh.ViewModels"
             x:Class="Stakh.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Balances">

    <Grid RowDefinitions="*,Auto" Padding="16" RowSpacing="12">
        <CollectionView Grid.Row="0" ItemsSource="{Binding Balances}">
            <CollectionView.EmptyView>
                <Label Text="No balances yet."
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:BalanceViewModel">
                    <Border Padding="16" Margin="0,4">
                        <Label Text="{Binding Name}" FontSize="18" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="Add balance"
                Command="{Binding AddBalanceCommand}" />
    </Grid>
</ContentPage>
