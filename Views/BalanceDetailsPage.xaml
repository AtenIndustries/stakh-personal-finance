<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Stakh.ViewModels"
             x:Class="Stakh.Views.BalanceDetailsPage"
             x:DataType="vm:BalanceDetailsViewModel"
             Title="Balance Details">


    <Grid RowDefinitions="Auto, *, Auto"
          Padding="20"
          RowSpacing="20">

        <!-- Linha 0: Nome do Saldo (Estava a ser tapado) -->
        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label Text="Active balance:"
                   FontSize="12"
                   TextColor="Gray"
                   CharacterSpacing="1"/>
            <Label Text="{Binding Name}"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}"/>
        </VerticalStackLayout>

        <!-- Linha 1: Lista (Fica com todo o espaço do meio) -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding MonthBalances}">
            
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:MonthBalanceViewModel">
                    <Border StrokeShape="RoundRectangle 10"
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E1E}"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#2C2C2C}">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"/>
                                <Label Text="{Binding Month, StringFormat='Month: {0}'}" FontSize="12" TextColor="Gray"/>
                                <Label Text="{Binding Year, StringFormat='Year: {0}'}" FontSize="12" TextColor="Gray"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="30">
                    <Label Text="No month balances available." TextColor="Gray" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Linha 2: Botão fixo no rodapé (Impedindo que ele estique) -->
        <Button Grid.Row="2"
                Text="Add month balance"
                Command="{Binding AddMonthBalanceCommand}"
                VerticalOptions="End"
                HeightRequest="50"/> 
    </Grid>
</ContentPage>