<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Stakh.Features.MonthBalances"
             x:Class="Stakh.Features.MonthBalances.AddMonthBalancePage"
             x:DataType="vm:AddMonthBalanceViewModel"
             Title="Add month balance">

    <VerticalStackLayout Padding="16" Spacing="16">
        <Entry Placeholder="Year" Text="{Binding YearText}" Keyboard="Numeric" />
        <Entry Placeholder="Month" Text="{Binding MonthText}" Keyboard="Numeric" />
        <Button Text="Save" Command="{Binding SaveCommand}" />
    </VerticalStackLayout>
</ContentPage>