<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Stakh.Features.ExpenseReports"
             x:Class="Stakh.Features.ExpenseReports.ExpenseReportListPage"
             x:DataType="vm:ExpenseReportListViewModel"
             Title="Expense reports">

    <Grid RowDefinitions="*,Auto"
            Padding="16"
            RowSpacing="12">
        <CollectionView Grid.Row="0"
                ItemsSource="{Binding ExpenseReports}">
            <CollectionView.EmptyView>
                <Label Text="No expense reports yet."
                       HorizontalOptions="Center"
                        VerticalOptions="Center"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ExpenseReportEntryViewModel">
                    <Border Padding="16"
                            Margin="0,4"
                            Background="Transparent">
                        <!-- Adds click to border-->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.LoadExpenseReportsCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                            CommandParameter="{Binding .}"
                            x:DataType="{x:Null}"/>
                        </Border.GestureRecognizers>

                        <Label Text="{Binding Name}"
                                FontSize="18"/>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1"
                Text="Add expense report"
                Command="{Binding AddExpenseReportCommand}"/>
    </Grid>
</ContentPage>
